# ============================================================
# Discharge Explainer - Environment Configuration
# ============================================================

# ------------------------------------------------------------
# 1. OPTION A: FREE HOSTED CLOUD SETUP (Render + Supabase + Groq/Free LLM)
# ------------------------------------------------------------
# Backend general settings
APP_ENV=production
API_ACCESS_TOKEN=
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
MAX_REQUEST_BYTES=5000000
DOCUMENT_RETENTION_DAYS=7
OCR_MAX_PAGES=25

# Supabase PostgreSQL (paste your Supabase connection string)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# Free hosted inference (Groq, OpenRouter, Together, or Gemini OpenAI-compatible)
# Groq provides free high-speed API keys: https://console.groq.com/keys
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=gsk_your_free_groq_api_key_here
MODEL_ID=llama-3.1-8b-instant
TRANSLATION_JUDGE_MODEL_ID=llama-3.1-8b-instant
TRANSLATION_MODEL_ID=llama-3.1-8b-instant
ALLOW_REMOTE_LLM=true

# Allowed Frontend Origins (e.g. your Vercel or Cloudflare URL)
CORS_ORIGINS=https://your-app.vercel.app,http://localhost:3000

# ------------------------------------------------------------
# 2. OPTION B: LOCAL DEVELOPMENT SETUP (SQLite + Local Ollama)
# ------------------------------------------------------------
# DATABASE_URL=sqlite:///./discharge_explainer.db
# LLM_PROVIDER=ollama
# LLM_BASE_URL=http://localhost:11434/v1
# MODEL_ID=qwen3:1.7b
# TRANSLATION_JUDGE_MODEL_ID=qwen3:1.7b
# TRANSLATION_MODEL_ID=mashriram/sarvam-1
# ALLOW_REMOTE_LLM=false

# ------------------------------------------------------------
# Frontend Configuration (Used at build time in Vercel / Cloudflare)
# ------------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=https://discharge-explainer-backend.onrender.com
