# Backend
APP_ENV=development
API_ACCESS_TOKEN=
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
DATABASE_URL=sqlite:///./discharge_explainer.db
CORS_ORIGINS=http://localhost:3000

# Local Ollama endpoint; public model endpoints are rejected. Model must already exist in `ollama list`.
LLM_BASE_URL=http://localhost:11434/v1
MODEL_ID=qwen3:1.7b
# Hindi translation and its second-pass reviewer; both must be installed locally.
TRANSLATION_MODEL_ID=qwen3:1.7b
TRANSLATION_JUDGE_MODEL_ID=qwen3:1.7b
FACT_EXTRACTION_MODE=deterministic
# Uses the configured local model to check whether linked source facts support each claim.
ENTAILMENT_JUDGE_ENABLED=true
MAX_REQUEST_BYTES=5000000
DOCUMENT_RETENTION_DAYS=7
OCR_MAX_PAGES=25
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
